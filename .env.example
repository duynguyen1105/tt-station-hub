# === Database (Supabase Postgres) ===
# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL=

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=station-photos

# === AI Vision (Anthropic) ===
ANTHROPIC_API_KEY=

# === Cron / scheduled tasks ===
CRON_SECRET=

# === Mock modes (develop without an API key or Supabase Storage) ===
AI_MOCK=false
STORAGE_MOCK=false
